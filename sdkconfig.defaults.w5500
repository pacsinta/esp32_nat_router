# Wi-Fi STA upstream with W5500 Ethernet LAN downlink.
CONFIG_ETH_DOWNLINK_W5500=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_ETH_SPI_HOST=1
CONFIG_ETH_SPI_MISO_GPIO=19
CONFIG_ETH_SPI_MOSI_GPIO=23
CONFIG_ETH_SPI_SCLK_GPIO=18
CONFIG_ETH_SPI_CS_GPIO=5
CONFIG_ETH_SPI_INT_GPIO=-1
CONFIG_ETH_SPI_RST_GPIO=16
CONFIG_ETH_SPI_CLOCK_MHZ=10
CONFIG_ETH_SPI_POLL_MS=2